  "autonomy": {
    "level": 2
  },
  "risk_profile": {
    "level": "medium"
  },
  "data_handling": {
    "stores_personal_data": false
  },
  "stopping_authority": {
    "stoppable_by": [
      "owner",
      "operator"
    ],
    "mechanism": "revoke on-chain permissions / disable endpoints"
  },
  "audit_surface": {
    "logging": "detailed",
    "reconstructability": "partial",
    "notes": "On-chain Base settlements plus public docs/MCP; off-chain MCP proxy logs are basic."
  },
  "contact": {
    "email": "ops@0xhumans.com"
  }
