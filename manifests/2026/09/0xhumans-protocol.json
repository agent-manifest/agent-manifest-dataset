{
  "manifest_version": "1.0",
  "agent_id": "0xhumans-protocol",
  "agent_name": "0xHumans",
  "agent_version": "1.0.0",
  "owner": {
    "type": "organization",
    "identifier": "https://0xhumans.com"
  },
  "purpose": {
    "primary_code": "commerce",
    "description": "Permissionless USDC commerce and financing for autonomous agents on Base, including skill registry and revenue-based lending."
  },
  "forbidden_actions": [
    "impersonate_humans",
    "exfiltrate_private_keys",
    "bypass_user_consent"
